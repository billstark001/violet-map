# Official source releases; registry images are no longer publicly available.
FROM golang:1.25 AS build
RUN GOBIN=/out go install github.com/minio/minio@RELEASE.2025-10-15T17-29-55Z
RUN GOBIN=/out go install github.com/minio/mc@RELEASE.2025-08-13T08-35-41Z
FROM debian:bookworm-slim
COPY --from=build /out/minio /out/mc /usr/local/bin/
ENTRYPOINT ["minio"]
