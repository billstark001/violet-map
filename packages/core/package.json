{
  "name": "@violet-map/core",
  "version": "0.1.0",
  "files": [
    "dist",
    "data-defaults"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nbt": {
      "development": "./src/nbt.ts",
      "types": "./dist/nbt.d.ts",
      "default": "./dist/nbt.js"
    },
    "./region": {
      "development": "./src/region.ts",
      "types": "./dist/region.d.ts",
      "default": "./dist/region.js"
    },
    "./storage": {
      "development": "./src/storage.ts",
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./domain": {
      "development": "./src/domain.ts",
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./assets": {
      "development": "./src/assets.ts",
      "types": "./dist/assets.d.ts",
      "default": "./dist/assets.js"
    },
    "./formats/top-map": {
      "development": "./src/formats/topMap.ts",
      "types": "./dist/formats/topMap.d.ts",
      "default": "./dist/formats/topMap.js"
    },
    "./contracts": {
      "development": "./src/contracts.ts",
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./defaults": {
      "development": "./src/defaults.ts",
      "types": "./dist/defaults.d.ts",
      "default": "./dist/defaults.js"
    },
    "./async": {
      "development": "./src/async.ts",
      "types": "./dist/async.d.ts",
      "default": "./dist/async.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "start": "node -e \"console.log('@violet-map/core is a library package with no standalone service')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "pako": "^3.0.0",
    "prismarine-nbt": "^2.8.0"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "typescript": "^6.0.3"
  }
}
