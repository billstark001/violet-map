{
  "name": "@violet-map/cli",
  "version": "0.2.0",
  "bin": {
    "violet-map": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "dev": "tsx --conditions=development src/cli.ts",
    "start": "node dist/cli.js --help",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:artifact": "node --test test/artifact.test.mjs",
    "test:keychain": "tsx --conditions=development --test test/keychain.integration.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@violet-map/core": "workspace:*",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "minecraft-data": "^3.111.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pngjs": "^6.0.5",
    "@violet-map/render": "workspace:*",
    "@violet-map/server": "workspace:*",
    "@violet-map/storage": "workspace:*",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@violet-map/render": "workspace:^",
    "@violet-map/server": "workspace:^",
    "@violet-map/storage": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@violet-map/server": {
      "optional": true
    },
    "@violet-map/render": {
      "optional": true
    },
    "@violet-map/storage": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
