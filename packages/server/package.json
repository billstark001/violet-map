{
  "name": "@violet-map/server",
  "version": "0.2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./admin": {
      "development": "./src/admin.ts",
      "types": "./dist/src/admin.d.ts",
      "default": "./dist/src/admin.js"
    },
    "./app": {
      "development": "./src/app.ts",
      "types": "./dist/src/app.d.ts",
      "default": "./dist/src/app.js"
    },
    "./configuration": {
      "development": "./src/configuration.ts",
      "types": "./dist/src/configuration.d.ts",
      "default": "./dist/src/configuration.js"
    },
    "./services": {
      "development": "./src/services.ts",
      "types": "./dist/src/services.d.ts",
      "default": "./dist/src/services.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json --noEmit false && node scripts/build-resources.mjs",
    "dev": "tsx watch --conditions=development src/index.ts",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check && tsx src/db/check.ts",
    "db:status": "node dist/src/db/maintenance.js status",
    "db:migrate": "node dist/src/db/maintenance.js migrate",
    "db:baseline": "node dist/src/db/maintenance.js baseline",
    "test:db": "tsx --conditions=development --test test/migrations.test.ts",
    "test:db:artifact": "node --test test/maintenance-artifact.test.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@hono/node-server": "^2.0.8",
    "@msgpack/msgpack": "^3.1.3",
    "@violet-map/core": "workspace:*",
    "@violet-map/storage": "workspace:*",
    "@xmldom/xmldom": "^0.9.12",
    "drizzle-orm": "0.45.4",
    "fresh": "^0.5.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "hono": "^4.12.27",
    "minecraft-data": "^3.111.0",
    "pako": "^3.0.0",
    "pg": "^8.22.0",
    "pngjs": "^7.0.0",
    "prismarine-nbt": "^2.8.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/fresh": "^0.5.3",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
