{
  "name": "@violet-map/resources",
  "version": "0.4.0",
  "files": [
    "dist",
    "data-defaults"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog/sqlite": {
      "development": "./src/catalog/sqlite.ts",
      "types": "./dist/catalog/sqlite.d.ts",
      "default": "./dist/catalog/sqlite.js"
    },
    "./asset-pack": {
      "development": "./src/assetPack.ts",
      "types": "./dist/assetPack.d.ts",
      "default": "./dist/assetPack.js"
    },
    "./world-chunks": {
      "development": "./src/sources/worldChunks.ts",
      "types": "./dist/sources/worldChunks.d.ts",
      "default": "./dist/sources/worldChunks.js"
    },
    "./nbt-codec": {
      "development": "./src/sources/nbtCodec.ts",
      "types": "./dist/sources/nbtCodec.d.ts",
      "default": "./dist/sources/nbtCodec.js"
    },
    "./game-data": {
      "development": "./src/gameData.ts",
      "types": "./dist/gameData.d.ts",
      "default": "./dist/gameData.js"
    },
    "./top-map": {
      "development": "./src/topMapDependencies.ts",
      "types": "./dist/topMapDependencies.d.ts",
      "default": "./dist/topMapDependencies.js"
    },
    "./asset-digest": {
      "development": "./src/assetDigest.ts",
      "types": "./dist/assetDigest.d.ts",
      "default": "./dist/assetDigest.js"
    },
    "./top-map-source": {
      "development": "./src/topMapSource.ts",
      "types": "./dist/topMapSource.d.ts",
      "default": "./dist/topMapSource.js"
    },
    "./top-map-bake": {
      "development": "./src/topMapBake.ts",
      "types": "./dist/topMapBake.d.ts",
      "default": "./dist/topMapBake.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:artifact": "node --test test/artifact.test.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@violet-map/core": "workspace:*",
    "@violet-map/storage": "workspace:*",
    "minecraft-data": "^3.111.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
