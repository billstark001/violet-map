FROM node:24-bookworm-slim AS build
RUN corepack enable
WORKDIR /workspace
COPY . .
ARG VITE_BASE_PATH=/
RUN pnpm install --frozen-lockfile && pnpm --filter @violet-map/admin... build

FROM node:24-bookworm-slim
ENV NODE_ENV=production PORT=3310 STATIC_BASE_PATH=/
WORKDIR /app
COPY --from=build --chown=node:node /workspace/packages/admin/dist/ ./
USER node
EXPOSE 3310
CMD ["node", "serve.mjs"]
